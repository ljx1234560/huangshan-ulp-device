# Bind to loopback for host-only development. A non-loopback bind requires at
# least one VELAPET_DEVICE_TOKENS value.
VELAPET_HOST=127.0.0.1
VELAPET_PORT=8000
VELAPET_DATA_ROOT=./runtime-data
VELAPET_DEVICE_TOKENS=replace-with-a-long-random-device-token
VELAPET_CHAT_RATE_LIMIT_PER_MINUTE=20
VELAPET_CHAT_PROVIDER=deepseek

# The model key stays on this backend and must never be copied to firmware.
MIMO_API_KEY=
MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_CHAT_MODEL=mimo-v2.6-flash
MIMO_TIMEOUT_SECONDS=30

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
