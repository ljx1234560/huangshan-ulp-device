VELAPET_ENV=development
# 本机开发默认使用 SQLite。PostgreSQL 示例：
# postgresql+psycopg://velapet:<password>@localhost:5432/velapet
VELAPET_DATABASE_URL=sqlite:///./velapet.db
VELAPET_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
VELAPET_COOKIE_SECURE=false
VELAPET_ACCESS_SESSION_MINUTES=30
VELAPET_REFRESH_SESSION_DAYS=14

# 文本 AI：mock（默认）、deepseek 或 existing_velapet。
# DeepSeek：将 Provider 改为 deepseek，填写 API Key 和账户实际可用模型；Base URL 保持 https://api.deepseek.com。
# existing_velapet：使用 SERVICE_URL 和 DEVICE_TOKEN，不使用 DeepSeek API Key。
VELAPET_TEXT_AI_PROVIDER=mock
VELAPET_TEXT_AI_API_KEY=
VELAPET_TEXT_AI_BASE_URL=https://api.deepseek.com
VELAPET_TEXT_AI_MODEL=
VELAPET_TEXT_AI_TIMEOUT_SECONDS=20
VELAPET_TEXT_AI_SERVICE_URL=http://127.0.0.1:8010
VELAPET_TEXT_AI_DEVICE_TOKEN=

# 图片 AI：mock（默认）、openai 或 doubao。所有真实 Provider 的 API Key 和模型 ID 都必须显式配置。
# OpenAI：Base URL=https://api.openai.com/v1，SIZE 使用宽x高，QUALITY 按模型能力配置。
# 豆包 Seedream：Base URL=https://ark.cn-beijing.volces.com/api/v3；模型填写账户实际可用 ID。
# Seedream 5.0 Flash 建议 SIZE=2K、OUTPUT_FORMAT=png、BACKGROUND=opaque；不要给 Flash 使用 auto 背景。
VELAPET_IMAGE_AI_PROVIDER=mock
VELAPET_IMAGE_AI_API_KEY=
VELAPET_IMAGE_AI_BASE_URL=https://api.openai.com/v1
VELAPET_IMAGE_AI_MODEL=
VELAPET_IMAGE_AI_TIMEOUT_SECONDS=120
VELAPET_IMAGE_AI_SIZE=1024x1024
VELAPET_IMAGE_AI_QUALITY=medium
VELAPET_IMAGE_AI_OUTPUT_FORMAT=png
VELAPET_IMAGE_AI_BACKGROUND=auto
VELAPET_IMAGE_AI_RESPONSE_FORMAT=b64_json
VELAPET_IMAGE_AI_WATERMARK=false
VELAPET_IMAGE_STORAGE_DIR=./data/pet-images
VELAPET_IMAGE_MAX_BYTES=10485760
VELAPET_IMAGE_DAILY_LIMIT=10
VELAPET_IMAGE_CONCURRENT_LIMIT=1
VELAPET_IMAGE_JOB_MAX_ATTEMPTS=2
VELAPET_IMAGE_JOB_STALE_MINUTES=10

# 仅开发环境使用；Demo 数据不得作为真实运营数据。
VELAPET_SEED_DEMO=true

# 付费在线冒烟测试必须由使用者临时显式改为 1；正常服务和自动化测试保持 0。
VELAPET_RUN_ONLINE_AI_SMOKE=0
VELAPET_RUN_ONLINE_IMAGE_SMOKE=0
VELAPET_RUN_ONLINE_DOUBAO_IMAGE_SMOKE=0
